# 账号仅在首次初始化数据库时创建，修改环境变量不会重置已有账号。
ADMIN_USERNAME=admin
# 首次部署必须填写至少 12 位密码，不能使用示例密码。
ADMIN_PASSWORD=
# 填写浏览器实际访问的站点源（协议、域名及端口），用于写请求同源校验。
APP_ORIGIN=
# 默认仅本机可访问，供宿主机 HTTPS 反向代理转发；改为 0.0.0.0 会对外暴露端口。
BIND_ADDRESS=127.0.0.1
# 宿主机映射端口，容器内部固定为 3000。
APP_PORT=3000
# 登录有效期，默认 30 天。
SESSION_TTL_DAYS=30
# 默认仅 HTTPS 发送登录 Cookie，仅本地 HTTP 测试时改为 false。
COOKIE_SECURE=true
