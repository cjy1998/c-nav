# 服务器端 .env 模板（实际文件：/opt/c-nav/.env，权限 600）
# IMAGE_TAG 由 GitHub Actions 每次部署自动改写为 sha-<7位>，可手工改回旧 tag 回滚
IMAGE_TAG=latest

# 只监听本机，由 1Panel 的 OpenResty 反代出去
BIND_ADDRESS=127.0.0.1
APP_PORT=3000

ADMIN_USERNAME=admin
# 至少 12 位；仅首次初始化数据库时生效，改它不会重置已有密码
ADMIN_PASSWORD=CHANGE_ME_20_CHARS
SESSION_TTL_DAYS=30

# 走 HTTPS 时必须为 true
COOKIE_SECURE=true
# 必须与浏览器地址栏完全一致（协议 + 域名，不带路径）
APP_ORIGIN=https://nav.deepthinkspace.cn
