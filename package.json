{
  "name": "personal-navigation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c orange,cyan \"tsx watch server/src/index.ts\" \"vite --config web/vite.config.ts\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && tsup server/src/index.ts --format esm --platform node --target node22 --out-dir dist/server --clean",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "hono": "^4.13.13",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
